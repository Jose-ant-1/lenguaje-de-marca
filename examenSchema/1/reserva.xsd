<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    
    <xs:simpleType name="nombreType">
        <xs:restriction base="xs:string"></xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="apellidosType">
        <xs:restriction base="xs:string"></xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="edadType">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="18"></xs:minInclusive>
            <xs:maxInclusive value="120"></xs:maxInclusive>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="direccionType">
        <xs:restriction base="xs:string"></xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="confimacionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="si"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="habitacionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="individual"></xs:enumeration>
            <xs:enumeration value="doble"></xs:enumeration>
            <xs:enumeration value="suite"></xs:enumeration>
        </xs:restriction>
    </xs:simpleType>


    <xs:element name="reservas" >
        <xs:complexType>
            <xs:sequence maxOccurs="50" minOccurs="1">
                <xs:element name="reserva">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="cliente">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nombre" type="nombreType"></xs:element>
                                        <xs:element name="apellidos" type="apellidosType"></xs:element>
                                        <xs:element name="edad" type="edadType"></xs:element>
                                        <xs:element name="direccion" type="direccionType"></xs:element>
                                        <xs:choice>
                                            <xs:element name="telefono" type="xs:int"></xs:element>
                                            <xs:element name="email" type="xs:string"></xs:element>
                                        </xs:choice>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="habitacion">
                                <xs:complexType mixed="true">
                                    <xs:attribute name="tipo" type="habitacionType"></xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="confirmada" type="confimacionType"></xs:attribute>
                    </xs:complexType>  
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>